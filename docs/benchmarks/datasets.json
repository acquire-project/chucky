{
  "version": 1,
  "definitions": {
    "throughput_gibs": "Original input GiB divided by append-and-flush wall time, including append-buffer allocation and prefill. Stream creation is timed separately. Discard sink.",
    "compression_fold": "Reported padded chunk bytes / encoded sink bytes. Tail padding is included; this is not original input bytes / encoded bytes. Precision is limited to the benchmark output.",
    "measured_device_gib": "Median device free-memory delta from before stream creation to after the run while the stream is alive. Initial CUDA context predates the baseline. Not a sampled peak.",
    "estimated_device_gib": "Explicit device allocations for the whole stream. Excludes pinned host allocations and additional runtime headroom. Allocation budgets filter this quantity only.",
    "estimated_pinned_gib": "Separately estimated pinned host allocations; unavailable in the 5070 summary.",
    "ranges": "Observed min\u2013max across measured repetitions, excluding warmups. Not confidence intervals or significance tests.",
    "comparison": "Whole-system results: GPU, CPU, transfers, OS, compiler, source revision and build differ. Synthetic repeated input; not independent microscopy frames. Exact-median frontiers can be sensitive to small measurement differences."
  },
