# syntax=docker/dockerfile:1

FROM rust:1.85-bookworm AS build

ARG S3_BLACKHOLE_REV=3b736b60ba0516a7b89035dbd3893cd4b8222f51
RUN cargo install \
        --locked \
        --git https://github.com/nclack/s3-blackhole.git \
        --rev "${S3_BLACKHOLE_REV}" \
        s3-blackhole

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /usr/local/cargo/bin/s3-blackhole /usr/local/bin/s3-blackhole

USER 65534:65534
EXPOSE 9000
STOPSIGNAL SIGTERM

ENTRYPOINT ["s3-blackhole"]
CMD ["--listen", "0.0.0.0:9000"]
